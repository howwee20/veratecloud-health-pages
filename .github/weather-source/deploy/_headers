# Header rules in the "_headers" format used by Netlify and Cloudflare Pages,
# for the Michigan Weather Continuity prototype.
#
# EXAMPLE ONLY. UNTESTED. This file has never been deployed to either service.
# To try it, copy it into the publish directory (the built dist/) at deploy
# time; it is deliberately not part of the build.
#
#   * Header values mirror deploy/security-headers.json exactly; that file is
#     the single source. tests/unit/deploy-examples.test.ts fails if they drift.
#   * Final headers need review by MSU IT security before any production use.
#   * DNS, routing and hosting changes need institutional approval.
#
# Strict-Transport-Security: deploy/security-headers.json lists it as HTTPS
# only. This format cannot make a header conditional on the scheme. Keep the
# line only on a host that serves this site over HTTPS exclusively (plain HTTP
# requests answered with a redirect); otherwise remove it and set HSTS where
# TLS is terminated.
#
# Legacy query-string URLs (/station.asp?id=bnz, /report.asp?fileid=bnzh) cannot
# be handled here. A _headers file only adds headers, and static hosting cannot
# rewrite query strings by itself. See deploy/README.md and the nginx and Apache
# examples; deploy/legacy-url-map.csv is the source of the full mapping.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action https://mawn.geo.msu.edu; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

# Long cache for build assets: their file names carry a content hash.
# No Cache-Control is set under "/*" on purpose. When two matching rules set
# the same header these services may join the values instead of replacing
# them, so HTML is left on the host's default short, revalidating cache.
# Confirm that default on the chosen service; if it is not short, add an
# explicit rule per page path rather than one under "/*".
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Raw logger files have no file extension and must be served as text/plain.
# Each file is listed by name: a "/rawdata/3hr/*" rule would also relabel the
# listing page (index.html) and index.json in the same directory. Only one raw
# file is in this prototype; a full migration would generate one entry per file.
/rawdata/3hr/benzonia
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
