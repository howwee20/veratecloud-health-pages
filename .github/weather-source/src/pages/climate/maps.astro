---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClimateMapDescription from '../../components/ClimateMapDescription.astro';
import {climate} from '../../lib/data';
import descriptions from '../../../data/normalized/map-descriptions.json';
const filename=(url:string)=>url.split('/').pop() as keyof typeof descriptions;
---
<BaseLayout title="Michigan Climate Maps" section="climate" source={climate.maps.source.url}>
<h1>Michigan Climate Maps</h1>
<p>Click on a map for larger version and regional text values.</p>
<p>Precipitation totals and departures are in inches; percent-of-normal maps are in percent. Temperatures are in degrees F.</p>
{climate.maps.groups.map(g=><section class="map-group"><h2>{g.title}</h2><div class="climate-maps">{g.maps.map(m=><figure>
<figcaption>{m.period}</figcaption>
<a href={'/climate/maps/'+filename(m.imageUrl).replace('.png','')+'/'}><img src={'/media/climate/'+filename(m.imageUrl)} width="150" height="200" loading="lazy" alt={`${g.title}, Michigan, ${m.period.toLowerCase()}. Open larger map and regional text values.`}/></a>
<details class="map-description"><summary>Text description<span class="visually-hidden">: {g.title}, {m.period}</span></summary><ClimateMapDescription name={filename(m.imageUrl)}/></details>
</figure>)}</div></section>)}
</BaseLayout>
