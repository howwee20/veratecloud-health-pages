---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {dailyTemperatures} from '../../../lib/daily-temperatures';
---
<BaseLayout title="Daily Maximum and Minimum Temperatures" section="agweather">
<article class="local-product">
  <h1>Daily Maximum and Minimum Temperatures</h1>
  <p><a href="/agricultural-weather/current/">Current Weather</a> · <a href="/weather-network/">Weather Station Network</a></p>
  <p>Latest daily MAWN air temperatures, in degrees Fahrenheit. Observation dates vary by station. --, --- and NA indicate no reported value.</p>
  <p><a href="/agricultural-weather/daily-temperatures/temperatures.csv" download>Download daily temperatures (CSV)</a></p>
  <div class="table-wrap" role="region" aria-label="Daily station temperatures" tabindex="0">
    <table class="data">
      <caption>Latest reported daily maximum and minimum temperatures</caption>
      <thead><tr><th scope="col">Station</th><th scope="col">Observation date</th><th scope="col">Maximum (°F)</th><th scope="col">Minimum (°F)</th></tr></thead>
      <tbody>{dailyTemperatures.map(row=><tr><th scope="row"><a href={`/weather-network/stations/${row.id}/daily/`}>{row.station}</a></th><td>{row.date}</td>{[row.maximum,row.minimum].map(value=><td>{/^(--|---|NA)$/.test(value)?<><span aria-hidden="true">{value}</span><span class="visually-hidden">No value reported</span></>:value}</td>)}</tr>)}</tbody>
    </table>
  </div>
</article>
</BaseLayout>
