---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {stationDetails} from '../../../../lib/data';
import {localHref} from '../../../../lib/route';
export function getStaticPaths(){return Object.keys(stationDetails).map(id=>({params:{id}}))}
const {id}=Astro.params; const d=stationDetails[id!];
const fields=[['Station',d.stationName],['Station ID',d.id],['Location',d.location],['City',d.city],['Latitude',d.latitude.raw],['Longitude',d.longitude.raw],['Elevation',d.elevation.raw]];
---
<BaseLayout title={`${d.city} (${d.stationName}) weather station`} source={d.legacyUrl}>
<section class="station-info" aria-label="Station information"><dl>{fields.map(([label,value],i)=><><dt>{label}:</dt><dd>{i===0?<h1>{value}</h1>:value}</dd></>)}</dl>{d.localPhoto && <img src={d.localPhoto} width="325" height="216" alt={`Weather instruments at ${d.location}, ${d.city}`}/>}</section>
{d.group==='retired' && <p class="source-details">Retired station{d.retiredDateRaw ? ` · ${d.retiredDateRaw}` : ''}. Reports show the source’s available historical observations.</p>}<div class="station-reports"><section><h2 class="green-heading">Recent Weather Data:</h2><ul class="arrow-links">{d.reportLinks.filter(r=>r.fileid.slice(-1)!=='m').map(r=><li><a href={localHref(r.url)}>{r.label}</a></li>)}</ul></section><section><h2 class="green-heading">Station Reports:</h2><ul class="arrow-links"><li><a href={`/weather-network/stations/${id}/maintenance/`}>Maintenance Reports</a></li></ul></section></div>
<section class="custom-reports"><h2 class="green-heading">Custom Reports (Data-on-Demand):</h2><p class="custom-note">{d.customReportNotice}</p><form action={`/weather-network/stations/${id}/custom/`} method="get"><input type="hidden" name="id" value={id}/><label for="report-type">Select report type:</label><select name="rt" id="report-type"><option value="24">Daily Data</option><option value="60">Hourly Data</option></select> <button type="submit">Open report</button></form></section>
</BaseLayout>
