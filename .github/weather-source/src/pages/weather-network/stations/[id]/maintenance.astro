---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SnapshotNotice from '../../../../components/SnapshotNotice.astro';
import {stationDetails} from '../../../../lib/data';
import {reportsByStation} from '../../../../lib/station';
export function getStaticPaths(){return Object.keys(reportsByStation).map(id=>({params:{id}}))}
const {id}=Astro.params;const s=stationDetails[id!];const d=reportsByStation[id!].maintenance;
---
<BaseLayout title={`${s.stationName} — Maintenance Reports`} source={d.source.url}><div class="report-page"><h1>{s.stationName} — Maintenance Reports</h1><ul class="subnav"><li><a href={`/weather-network/stations/${id}/`}>Station information</a></li><li><a href={`/weather-network/stations/${id}/daily/`}>Daily Data</a></li><li><a href={`/weather-network/stations/${id}/hourly/`}>Hourly Data</a></li></ul><p><a href={`/downloads/${id}-maintenance.txt`} download>Download maintenance log</a></p>{d.preface?.map(line=><p>{line}</p>)}{d.entries.length===0 && <pre class="report-text">{d.rawText}</pre>}{d.entries.map(e=><article class="maintenance-entry"><h2><time datetime={e.isoDate || undefined}>{e.dateRaw}</time>{e.heading && `: ${e.heading}`}{e.bracketCode&&` [${e.bracketCode}]`}</h2>{e.body.map(line=><p>{line}</p>)}</article>)}<SnapshotNotice sources={[d.source]}>{d.retainedPrevious && <p>The latest source response could not be read reliably. This is the last verified report.</p>}</SnapshotNotice></div></BaseLayout>
