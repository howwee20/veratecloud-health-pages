---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SnapshotNotice from '../../../../components/SnapshotNotice.astro';
import {stationDetails} from '../../../../lib/data';
import {reportsByStation} from '../../../../lib/station';
export function getStaticPaths(){return Object.keys(reportsByStation).map(id=>({params:{id}}))}
const {id}=Astro.params;const s=stationDetails[id!];const d=reportsByStation[id!].maintenance;
---
<BaseLayout title={`${s.stationName} — Maintenance Reports`} source={d.source.url}><div class="report-page"><h1>{s.stationName} — Maintenance Reports</h1><ul class="subnav"><li><a href={`/weather-network/stations/${id}/`}>Station information</a></li><li><a href={`/weather-network/stations/${id}/daily/`}>Daily Data</a></li><li><a href={`/weather-network/stations/${id}/hourly/`}>Hourly Data</a></li></ul><p><a href={`/downloads/${s.stationName}-maintenance.txt`} download>Download maintenance log</a></p>{d.entries.map(e=><article class="maintenance-entry"><h2>{e.heading || e.dateRaw}{e.bracketCode&&` [${e.bracketCode}]`}</h2>{e.body.map(line=><p>{line}</p>)}</article>)}<SnapshotNotice sources={[d.source]}/></div></BaseLayout>
