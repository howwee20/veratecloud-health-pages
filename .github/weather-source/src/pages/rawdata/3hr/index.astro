---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {rawdata} from '../../../lib/data';
import {localHref} from '../../../lib/route';
const d=rawdata.directories['3hr'];
---
<BaseLayout title={d.title} source={d.source.url}><div class="raw-list"><h1>{d.title}</h1><p><a href="/rawdata/">Parent Directory</a></p><div class="table-wrap" tabindex="0" role="region" aria-label="Data file directory"><table><caption class="visually-hidden">{d.title}</caption><thead><tr><th scope="col">Name</th><th scope="col">Last modified</th><th scope="col">Size</th></tr></thead><tbody>{d.entries.map(e=><tr><th scope="row"><a href={localHref(e.url)}>{e.name}</a></th><td>{e.lastModifiedRaw}</td><td>{e.sizeRaw}</td></tr>)}</tbody></table></div></div></BaseLayout>
