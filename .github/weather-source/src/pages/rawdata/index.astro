---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {rawdata} from '../../lib/data';
import {localHref} from '../../lib/route';
const d=rawdata.root;
---
<BaseLayout title={d.title} source={d.source.url}><div class="raw-list"><h1>{d.title}</h1><p><a href="/weather-network/">Parent Directory</a></p><div class="table-wrap" tabindex="0" role="region" aria-label="Data file directory"><table><caption class="visually-hidden">{d.title}</caption><thead><tr><th scope="col">Name</th><th scope="col">Last modified</th><th scope="col">Size</th></tr></thead><tbody>{d.entries.map(e=><tr><th scope="row">{e.name==='3hr/' ? <a href="/rawdata/3hr/">{e.name}</a> : e.name}</th><td>{e.lastModifiedRaw}</td><td>{e.sizeRaw}</td></tr>)}</tbody></table></div><p>Recent three-hour station files are available below.</p></div></BaseLayout>
