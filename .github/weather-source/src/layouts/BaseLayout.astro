---
import '../styles/legacy.css';
import expandedNetwork from '../../data/expanded/network.json';
import expandedProducts from '../../data/expanded/products.json';
import climateRefresh from '../../public/downloads/climate-map-refresh.json';
import additionalSources from '../../data/normalized/additional-sources.json';
import { agweather, climate, sources } from '../lib/data';
import { localHref } from '../lib/route';
const {title, description = title, section='network', climateHome=false, source} = Astro.props;
const isClimate=section==='climate'; const isAg=section==='agweather';
const path=Astro.url.pathname;
const original=source || (isClimate?'https://climate.geo.msu.edu/':isAg?'https://www.agweather.geo.msu.edu/':'https://mawn.geo.msu.edu/');
const receipt = Object.values(expandedNetwork.stations).find(s => s.legacyUrl===original)?.source || Object.values(expandedNetwork.reports).flatMap(s=>Object.values(s)).find(s=>s.source.url===original)?.source || expandedProducts.pages[original]?.source || sources.sources.find(s => s.url === original) || additionalSources.find(s => s.url === original);
const isMapPage=isClimate && (path==='/climate/' || path.startsWith('/climate/maps/'));
const saved = isMapPage ? climateRefresh.lastSuccessfulRefreshUtc : receipt?.retrievedAtUtc;
const savedLabel = saved ? new Date(saved).toLocaleString('en-US', {timeZone:'America/Detroit',month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}) + ' Eastern' : null;
const mawnLinks=[['Weather Station Network home','/weather-network/'],['Enviro-weather','https://enviroweather.msu.edu/'],['MSU Agricultural Weather Office','/agricultural-weather/'],["Michigan State Climatologist’s Office",'/climate/'],['MSU Department of Geography','https://geo.msu.edu/']];
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content="noindex,nofollow"/><title>{title} — Accessibility preview</title></head>
<body class:list={[isClimate?'climate-site':isAg?'ag-site':'mawn-site']}>
<a class="skip-link" href="#main-content">Skip to main content</a>
<p class="preview-label">{savedLabel ? `${isMapPage ? "Maps" : "Data"} saved ${savedLabel}` : "No source capture"}<a href="https://veratecloud.com/enviroweather/">Demos</a></p>
{isClimate && <header class="climate-header"><a href="/climate/"><img src="/media/legacy/climate-wordmark.png" width="520" height="49" alt="Michigan State Climatologist’s Office"/></a></header>}
<div class:list={['site-frame',isClimate?'climate-frame':'classic-frame',climateHome&&'climate-home']}>
<aside class="site-sidebar">
{isClimate ? <nav aria-label="Climate Office"><ul class="climate-nav">{climate.home.navigation.map((n)=><li><a href={localHref(n.url)} aria-current={path===localHref(n.url)?'page':undefined}>{n.label}</a></li>)}</ul></nav> : isAg ? <>
<a class="ag-msu" href="https://msu.edu/"><img src="/media/legacy/msu-logo.gif" width="125" height="43" alt="Michigan State University"/></a>
<div class="ag-stamp">{agweather.home.pageStampRaw}</div>
<div class="ag-status">Datafeed Status<small>(at capture)</small>{agweather.home.datafeedStatusRaw.map((s)=><div>{s}</div>)}</div>
<nav aria-label="Agricultural Weather"><ul class="ag-nav">{agweather.home.navigation.map((n)=><li><a href={localHref(n.url)} aria-current={path===localHref(n.url)?'page':undefined}>{n.label}</a></li>)}</ul></nav>
</> : <>
<a class="mawn-msu" href="https://msu.edu/" aria-label="Michigan State University"><span class="visually-hidden">Michigan State University</span></a>
<nav aria-label="Weather network"><ul class="mawn-nav">{mawnLinks.map(([label,href])=><li><a href={href} aria-current={path===href?'page':undefined}>{label}</a></li>)}</ul></nav>
<ul class="partner-logos" aria-label="Supporting organizations"><li><a class="logo-greeen" href="https://www.canr.msu.edu/project-greeen/" aria-label="Project GREEEN"></a></li><li><a class="logo-extension" href="https://www.canr.msu.edu/outreach/" aria-label="Michigan State University Extension"></a></li><li><a class="logo-maes" href="https://www.canr.msu.edu/research/" aria-label="Michigan Agricultural Experiment Station"></a></li></ul>
</>}
</aside>
<div class="site-body">
{!isClimate && <header class="classic-header">{isAg?<div class="ag-title">MSU Agricultural Weather Office</div>:<a href="/weather-network/"><img src="/media/legacy/mawn-header.gif" width="476" height="70" alt="Enviro-weather, formerly Michigan Automated Weather Network"/></a>}</header>}
<main id="main-content" tabindex="-1"><slot/></main>
</div>
{climateHome && <aside class="climate-thumbnails" aria-label="Recent climate maps"><p><strong>Climate Maps<br/>for 7, 30 and 90 days</strong></p>{climate.home.sidebarThumbnails.map((m,i)=><div><p>{i===0?'PRECIPITATION MAPS':'TEMPERATURE MAPS'}</p><a href="/climate/maps/"><img src={'/media/climate/'+m.imageUrl.split('/').pop()} alt={m.alt} width="94" height="122"/></a></div>)}</aside>}
</div>
{isClimate && <div class="climate-original-footer"><a href="https://msu.edu/"><img src="/media/legacy/msu-wordmark.png" width="103" height="23" alt="Michigan State University"/></a><p><strong>Department of Geography</strong><br/>116 Geography Building - East Lansing, Michigan, 48824<br/>Last updated: June 15, 2009 · © 2009 Michigan State University Board of Trustees.</p></div>}
<footer class="preview-footer"><nav aria-label="Site information"><ul><li><a href="/accessibility/">Accessibility &amp; preview notes</a></li><li><a href="/site-map/">Site map</a></li></ul></nav></footer>
</body></html>
