         ==============================================================================&nbsp;<br>Station&nbsp;Notes&nbsp;-&nbsp;Saginaw&nbsp;Valley:&nbsp;<br>&nbsp;<br>&nbsp;<br>11/26/2008:&nbsp;&nbsp;Station&nbsp;Retired&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;The&nbsp;MAWN&nbsp;station&nbsp;at&nbsp;Saginaw&nbsp;has&nbsp;been&nbsp;retired&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>05/29/2008:&nbsp;&nbsp;Station&nbsp;Maintenance:&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;General&nbsp;station&nbsp;maintenance&nbsp;and&nbsp;system&nbsp;checks,&nbsp;including:&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Soil&nbsp;Moisture&nbsp;sensors&nbsp;now&nbsp;installed&nbsp;vertically:&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;MSTR&nbsp;0:&nbsp;&nbsp;profile&nbsp;of&nbsp;depth&nbsp;=&nbsp;&nbsp;0&nbsp;-&nbsp;12"&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;MSTR&nbsp;1:&nbsp;&nbsp;profile&nbsp;of&nbsp;depth&nbsp;=&nbsp;12&nbsp;-&nbsp;24"&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Work&nbsp;was&nbsp;done&nbsp;approx:&nbsp;1000&nbsp;-&nbsp;1015&nbsp;(Day=150)&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>03/26/2008:&nbsp;&nbsp;Data&nbsp;Removal:&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;A&nbsp;small&nbsp;section&nbsp;of&nbsp;the&nbsp;data&nbsp;record&nbsp;from&nbsp;11/09/07&nbsp;-&nbsp;11/13/07&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;contained&nbsp;some&nbsp;corrupted&nbsp;data,&nbsp;possibly&nbsp;due&nbsp;to&nbsp;a&nbsp;low&nbsp;battery.&nbsp;<br>&nbsp;&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;The&nbsp;following&nbsp;five-minute&nbsp;data&nbsp;entries&nbsp;(and&nbsp;associated&nbsp;hourly&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;and&nbsp;daily&nbsp;entries)&nbsp;have&nbsp;been&nbsp;deleted:&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;11/09/2007&nbsp;(d=313):&nbsp;0740,&nbsp;0805&nbsp;-&nbsp;0815,&nbsp;0835&nbsp;-&nbsp;0845&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;11/12/2007&nbsp;(d=316):&nbsp;0410&nbsp;-&nbsp;2400&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;11/13/2007&nbsp;(d=317):&nbsp;0005&nbsp;-&nbsp;1725&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>03/07/2008:&nbsp;&nbsp;Station&nbsp;Maintenance&nbsp;(jb):&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Loaded&nbsp;MAWN&nbsp;Program:&nbsp;&nbsp;MAWN_AACF&nbsp;&nbsp;(hourly&nbsp;power&nbsp;cycle)&nbsp;&nbsp;[00:05]&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>===============================================================================&nbsp;<br>11/19/2007:&nbsp;&nbsp;Station&nbsp;Maintenance&nbsp;(jb):&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Loaded&nbsp;MAWN&nbsp;Program:&nbsp;&nbsp;MAWN_AACW&nbsp;&nbsp;&nbsp;(3-hr&nbsp;power&nbsp;cycle)&nbsp;&nbsp;[12:35]&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>07/25/2007:&nbsp;&nbsp;Station&nbsp;Maintenance:&nbsp;(bn):&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Communication&nbsp;converted&nbsp;to&nbsp;broadband&nbsp;cell-modem:&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Broadband&nbsp;Cell&nbsp;modem&nbsp;installed.&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Datalogger&nbsp;Program&nbsp;"mawn_aacs"&nbsp;Loaded&nbsp;and&nbsp;Compiled&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Data&nbsp;Collection&nbsp;Configured&nbsp;To&nbsp;Upload&nbsp;Every&nbsp;30&nbsp;minutes.&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;General&nbsp;Station&nbsp;Maintenance&nbsp;and&nbsp;System&nbsp;Checks:&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Work&nbsp;was&nbsp;done&nbsp;approx:&nbsp;15:30&nbsp;-&nbsp;16:00&nbsp;(Day=206)&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>05/08/2007:&nbsp;&nbsp;Station&nbsp;Maintenance&nbsp;(sm,&nbsp;bn):&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;General&nbsp;station&nbsp;maintenance&nbsp;and&nbsp;system&nbsp;checks.&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;soil&nbsp;temp&nbsp;1&nbsp;(4")&nbsp;replaced.&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;soil&nbsp;temp&nbsp;0&nbsp;(2")&nbsp;was&nbsp;reinstalled.&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Work&nbsp;was&nbsp;done&nbsp;approx:&nbsp;13:20&nbsp;-&nbsp;14:00&nbsp;(Day=128)&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>==============================================================================&nbsp;<br>03/14/2006:&nbsp;&nbsp;Station&nbsp;Maintenance:&nbsp;(sm)&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Tipping&nbsp;Bucket&nbsp;Rain&nbsp;Gauge&nbsp;at&nbsp;Saginaw&nbsp;Valley&nbsp;MAWN&nbsp;station&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;was&nbsp;covered&nbsp;during&nbsp;the&nbsp;winter.&nbsp;&nbsp;&nbsp;Cover&nbsp;was&nbsp;removed&nbsp;today&nbsp;&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;and&nbsp;precipitation&nbsp;data&nbsp;from&nbsp;this&nbsp;station&nbsp;should&nbsp;once&nbsp;&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;again&nbsp;show&nbsp;up&nbsp;in&nbsp;the&nbsp;data&nbsp;entries.&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>==============================================================================&nbsp;<br>&nbsp;<br>08/03/2004:&nbsp;&nbsp;Station&nbsp;Maintenance:&nbsp;(crn,jal)&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Replaced&nbsp;Anemometer&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Replaced&nbsp;Temperature/Relative&nbsp;Humidity&nbsp;Sensor&nbsp;-&nbsp;HMP45C&nbsp;(16:15)&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Checked&nbsp;Tipping&nbsp;Bucket&nbsp;Rain&nbsp;Guage&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Datalogger&nbsp;Program&nbsp;Loaded:&nbsp;&nbsp;MAWN1B&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>==============================================================================&nbsp;<br>&nbsp;<br>04/08/2002:&nbsp;&nbsp;Daylight&nbsp;Savings&nbsp;Time&nbsp;Adjustment.&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Daylight&nbsp;Savings&nbsp;Time&nbsp;Started&nbsp;on&nbsp;Day=97,&nbsp;Time=200.&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Time&nbsp;of&nbsp;Obs&nbsp;were&nbsp;modified&nbsp;by&nbsp;one&nbsp;hour&nbsp;(forward)&nbsp;&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;from&nbsp;Day=97,&nbsp;Time=200&nbsp;through&nbsp;Day=97,&nbsp;Time=415.&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>10/31/2001:&nbsp;&nbsp;Daylight&nbsp;Savings&nbsp;Time&nbsp;Adjustment.&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Daylight&nbsp;Savings&nbsp;Time&nbsp;Ended&nbsp;on&nbsp;Day=301,&nbsp;Time=200.&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Time&nbsp;of&nbsp;Obs&nbsp;were&nbsp;modified&nbsp;by&nbsp;one&nbsp;hour&nbsp;(subtracted)&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;from&nbsp;Day=301,&nbsp;Time=200&nbsp;through&nbsp;Day=301,&nbsp;Time=610.&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>10/09/2001:&nbsp;&nbsp;Phone&nbsp;Number&nbsp;Change.&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Area&nbsp;code&nbsp;for&nbsp;the&nbsp;SAGINAW&nbsp;region&nbsp;was&nbsp;changed&nbsp;over&nbsp;the&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;past&nbsp;weekend&nbsp;from&nbsp;"517"&nbsp;to&nbsp;"989".&nbsp;&nbsp;Phone&nbsp;number&nbsp;was&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;modified&nbsp;to&nbsp;reflect&nbsp;this&nbsp;change:&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>10/30/2000:&nbsp;&nbsp;Daylight&nbsp;Savings&nbsp;Time&nbsp;Adjustment.&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Daylight&nbsp;Savings&nbsp;Time&nbsp;Ended&nbsp;on&nbsp;Day=303,&nbsp;Time=200.&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Time&nbsp;of&nbsp;Obs&nbsp;were&nbsp;modified&nbsp;by&nbsp;one&nbsp;hour&nbsp;(subtracted)&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;from&nbsp;Day=303,&nbsp;Time=200&nbsp;through&nbsp;Day=304,&nbsp;Time=1700.&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Only&nbsp;Observation&nbsp;Times&nbsp;were&nbsp;modified,&nbsp;not&nbsp;times&nbsp;of&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Maxs&nbsp;and&nbsp;Mins.&nbsp;&nbsp;Users&nbsp;will&nbsp;need&nbsp;to&nbsp;take&nbsp;that&nbsp;into&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;consideration&nbsp;when&nbsp;using&nbsp;this&nbsp;data.&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>07/20/2000:&nbsp;&nbsp;Saginaw&nbsp;Valley&nbsp;Station&nbsp;added&nbsp;to&nbsp;MAWN&nbsp;database&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>07/19/2000:&nbsp;&nbsp;Data&nbsp;Logging&nbsp;Activated&nbsp;(mawn1a)&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Data&nbsp;Logger&nbsp;Start&nbsp;Time:&nbsp;&nbsp;00:05,&nbsp;Day=202&nbsp;(07/20/2000)&nbsp;<br>&nbsp;<br>&nbsp;<br>&nbsp;<br>07/19/2000:&nbsp;&nbsp;Station&nbsp;Update&nbsp;&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;Comments:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Paul&nbsp;Horny&nbsp;needed&nbsp;to&nbsp;unlock&nbsp;the&nbsp;gate&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;as&nbsp;well&nbsp;as&nbsp;a&nbsp;lock&nbsp;to&nbsp;the&nbsp;datalogger&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;enclosure.&nbsp;<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Basically&nbsp;standardized&nbsp;the&nbsp;Saginaw&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Valley&nbsp;station.&nbsp;&nbsp;The&nbsp;tripod&nbsp;was&nbsp;already&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;aligned&nbsp;properly.&nbsp;&nbsp;Replaced&nbsp;Temp/RH,&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Wind&nbsp;Sentry,&nbsp;Soil&nbsp;Temps,&nbsp;and&nbsp;Pyronemeter.&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Added&nbsp;Leaf&nbsp;Wetness&nbsp;A&nbsp;and&nbsp;Soil&nbsp;Moisture&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Probes.&nbsp;&nbsp;Moved&nbsp;Soil&nbsp;Temperature&nbsp;Sensors&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nb